{
  "name": "n3on-defense",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:itch": "tsc && vite build --config vite.itch.config.ts --mode production",
    "package:itch": "npm run build:itch && node scripts/package-itch.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "balance:report": "node --experimental-strip-types scripts/analyze-balance.ts",
    "economy:report": "node --experimental-strip-types scripts/analyze-economy.ts",
    "anomaly:report": "node --experimental-strip-types scripts/analyze-anomaly-rewards.ts",
    "arena:report": "node --experimental-strip-types scripts/analyze-arenas.ts",
    "telemetry:report": "node --experimental-strip-types scripts/analyze-gameplay-telemetry.ts",
    "performance:benchmark": "node --experimental-strip-types scripts/benchmark-combat-hotpaths.ts",
    "performance:soak": "node --experimental-strip-types scripts/benchmark-long-session.ts",
    "performance:world": "node --experimental-strip-types scripts/benchmark-world-presentation.ts",
    "performance:hazards": "node --experimental-strip-types scripts/benchmark-hazard-overlap.ts",
    "performance:heist": "node --experimental-strip-types scripts/benchmark-heist-runtime.ts",
    "performance:round-lifecycle": "node --experimental-strip-types scripts/benchmark-round-lifecycle.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
